{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 104857600
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/identity"
          }
        ]
      },
      "datasets": {
        "ClusterId": "datasets",
        "Match": {
          "Path": "/datasets/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/datasets"
          }
        ]
      },
      "labeling": {
        "ClusterId": "labeling",
        "Match": {
          "Path": "/labeling/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/labeling"
          }
        ]
      },
      "training": {
        "ClusterId": "training",
        "Match": {
          "Path": "/training/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/training"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "datasets": {
        "Destinations": {
          "primary": {
            "Address": "http://datasets:8080/"
          }
        }
      },
      "labeling": {
        "Destinations": {
          "primary": {
            "Address": "http://labeling:8080/"
          }
        }
      },
      "training": {
        "Destinations": {
          "primary": {
            "Address": "http://training:8080/"
          }
        }
      }
    }
  }
}
